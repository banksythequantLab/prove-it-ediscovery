{$DOMAIN} {
	request_body {
		max_size 210MB
	}
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
	}
	reverse_proxy app:8000
}
